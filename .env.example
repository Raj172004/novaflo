# NovaFlo configuration template
# Copy to .env.local and fill in local values.
# Never commit .env.local or real credentials.

# Site
NEXT_PUBLIC_SITE_URL=
NOVAFLO_NAME=Novaflo
NEXT_PUBLIC_NOVAFLO_EMAIL=
NEXT_PUBLIC_NOVAFLO_PHONE=
NEXT_PUBLIC_NOVAFLO_WHATSAPP=
NEXT_PUBLIC_NOVAFLO_INSTAGRAM=
NEXT_PUBLIC_NOVAFLO_LOCATION=
NEXT_PUBLIC_BOOKING_URL=

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Firebase Admin
FIREBASE_SERVICE_ACCOUNT_PATH=

# Admin authentication
ADMIN_PASSWORD=
LEADS_SECRET=

# Email notifications (Resend)
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
LEAD_EMAIL_FROM=

# Optional CRM integration
CRM_WEBHOOK_URL=
# Alternative to the service-account file path
FIREBASE_SERVICE_ACCOUNT_JSON=
