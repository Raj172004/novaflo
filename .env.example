# ── Novaflo site configuration ────────────────────────────────────────────────
# Copy to .env.local and fill in real values. Everything is optional:
# the website remains fully functional when a value is not set — the related
# UI (contact details, WhatsApp, analytics) simply stays hidden or disabled.

# Canonical site URL (used for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=

# Brand
NOVAFLO_NAME=Novaflo
NEXT_PUBLIC_NOVAFLO_EMAIL=
NEXT_PUBLIC_NOVAFLO_PHONE=
NEXT_PUBLIC_NOVAFLO_WHATSAPP=
NEXT_PUBLIC_NOVAFLO_INSTAGRAM=
NEXT_PUBLIC_NOVAFLO_LOCATION=

# Booking provider (Calendly etc.) — leave empty to use the built-in form only
NEXT_PUBLIC_BOOKING_URL=

# Analytics — loaded only after cookie consent is granted
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Server-side integrations (never exposed to the browser)
CRM_WEBHOOK_URL=

# Internal notification email target for new leads
LEAD_NOTIFICATION_EMAIL=
